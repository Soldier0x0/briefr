[Unit]
Description=BRIEFR CVE Intelligence Backend
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=briefr
Group=briefr
WorkingDirectory=/opt/vektor/backend
Environment="PATH=/opt/vektor/venv/bin"
EnvironmentFile=/opt/vektor/backend/.env
ExecStart=/opt/vektor/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=briefr-backend

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/vektor/backend

[Install]
WantedBy=multi-user.target
