[Unit]
# Dev only — production uses nginx + frontend/dist (see briefr-update.sh)
Description=BRIEFR Frontend dev server (Vite on 5173)
After=network.target briefr-backend.service
Wants=briefr-backend.service

[Service]
Type=simple
User=briefr
Group=briefr
WorkingDirectory=/opt/briefr/frontend
Environment="HOME=/var/lib/briefr"
Environment="PATH=/usr/bin:/bin"
Environment="npm_config_cache=/var/lib/briefr/.npm"
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 5173
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=briefr-frontend

[Install]
WantedBy=briefr.target
