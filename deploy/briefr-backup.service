[Unit]
Description=BRIEFR scheduled backup (PostgreSQL pg_dump + config)
Documentation=https://github.com/Soldier0x0/briefr
After=network-online.target

[Service]
Type=oneshot
User=briefr
Group=briefr
WorkingDirectory=/opt/briefr/backend
Environment="PATH=/opt/briefr/venv/bin:/usr/bin:/bin"
Environment="BACKUP_DIR=/var/lib/briefr/backups"
EnvironmentFile=-/opt/briefr/backend/.env
ExecStart=/opt/briefr/venv/bin/python -m backup run --reason scheduled
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Safe backup storage outside the git tree
ReadWritePaths=/var/lib/briefr/backups /opt/briefr/backend
ReadOnlyPaths=/opt/briefr/venv
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
