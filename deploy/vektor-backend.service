[Unit]
Description=VEKTOR CVE Intelligence Backend
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=vektor
Group=vektor
WorkingDirectory=/opt/vektor/backend
Environment="PATH=/opt/vektor/venv/bin"
EnvironmentFile=/opt/vektor/backend/.env
ExecStart=/opt/vektor/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --log-level info
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vektor-backend

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/vektor/backend

[Install]
WantedBy=multi-user.target
