# External Postgres — point BRIEFR at an existing server (no bundled container)
#
# Copy to backend/.env (or export before starting uvicorn):
#   cp deploy/external-postgres.env.example backend/.env
#
# Do NOT run deploy/docker-compose.postgres.yml when Postgres is already provisioned.

DATABASE_URL=postgresql://briefr:CHANGE_ME@db.example.com:5432/briefr
BRIEFR_REQUIRE_POSTGRES=1
DATABASE_POOL_SIZE=10
