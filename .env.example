# Try-out environment for docker-compose.yml.
# Copy to .env in the repo root and replace the placeholders.
# .env is gitignored. Do not commit it. Nothing here is copied into the images.
#
# Optional API keys and the full flag list: backend/.env.example

# Required when BRIEFR_ENV=production. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
BRIEFR_ENV=production
BRIEFR_REQUIRE_POSTGRES=1

# Bundled Postgres (--profile postgres). The password below must match the
# password inside DATABASE_URL. Use hex or other unreserved characters so the
# URL does not need encoding.
POSTGRES_USER=briefr
POSTGRES_PASSWORD=replace-with-a-password
POSTGRES_DB=briefr
DATABASE_URL=postgresql://briefr:replace-with-a-password@postgres:5432/briefr

# Existing Postgres on the Debian host (omit --profile postgres):
# the container reaches the host via host-gateway, mapped as host.docker.internal.
# Postgres must accept TCP on the Docker bridge address. A server bound only to
# 127.0.0.1 is not reachable through that hostname.
# DATABASE_URL=postgresql://briefr:replace-with-a-password@host.docker.internal:5432/briefr

# Plain HTTP try-out. Set AUTH_COOKIE_SECURE=1 when the site is served over HTTPS.
AUTH_COOKIE_SECURE=0
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Host port for the nginx container. Backend stays on 127.0.0.1:8000.
BRIEFR_HTTP_PORT=8080
# BRIEFR_BACKEND_PORT=8000

# Recommended once you want ingest headroom. Empty leaves the feature disabled.
# NVD_API_KEY=
