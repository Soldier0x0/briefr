NVD_API_KEY=your_nvd_api_key_here
VIRUSTOTAL_API_KEY=your_vt_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
# Free key at greynoise.io — required for IP scanning context (50 calls/week; opt-in per lookup)
GREYNOISE_API_KEY=your_greynoise_api_key_here
# One Auth-Key for MalwareBazaar + URLhaus — free at https://auth.abuse.ch/
ABUSECH_AUTH_KEY=your_abusech_auth_key_here
# Free at otx.alienvault.com — enables campaign correlation
OTX_API_KEY=your_otx_api_key_here
# OTX nightly campaign correlation job (default: 02:00 Asia/Kolkata; skipped if OTX_API_KEY unset)
OTX_CORRELATION_HOUR=2
OTX_CORRELATION_MINUTE=0
OTX_CORRELATION_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173,https://projectjupiter.in
# Set to production to disable Swagger/OpenAPI (/api/docs). Recommended on public deployments.
BRIEFR_ENV=development
# Optional — when set, POST /api/refresh* requires header X-BRIEFR-Admin-Key.
# Interim control for the beta; replaced by built-in app login before public release.
# BRIEFR_ADMIN_API_KEY=generate_a_long_random_secret_here
# Token-bucket rate limiting per client IP (in-memory; single worker).
# Over the limit → 429 with Retry-After. Set RATE_LIMIT_ENABLED=0 to disable.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_IOC_PER_MINUTE=30
RATE_LIMIT_REFRESH_PER_MINUTE=10
# Log output: json (one JSON object per line with request_id — default) or plain
LOG_FORMAT=json
# SQLite database file path (default: briefr.db in the backend working directory)
DB_PATH=briefr.db
# Backups — stored outside the git tree (production default: /var/lib/briefr/backups)
BACKUP_DIR=/var/lib/briefr/backups
# Keep the newest N archives (default 100). At 6h intervals ≈ 25 days of history.
BACKUP_RETENTION_COUNT=100
# age (X25519) archive encryption. Identity file MUST live outside BACKUP_DIR.
# Default: /var/lib/briefr/keys/backup-age.key when that file exists (created on
# first run by deploy/briefr-backup.sh). Set to "" to force plaintext archives.
# BACKUP_AGE_KEY_FILE=/var/lib/briefr/keys/backup-age.key
# Set to 0 to disable scheduled backups and startup auto-restore
BACKUP_ENABLED=1
# Rotating backup log in ${BACKUP_DIR}/logs/backup.log
BACKUP_LOG_MAX_BYTES=5242880
BACKUP_LOG_BACKUP_COUNT=5
CACHE_REFRESH_HOUR=6
CACHE_REFRESH_MINUTE=0
# MITRE ATT&CK + ATLAS weekly refresh (Sunday 02:00 IST by default)
MITRE_REFRESH_HOUR=2
MITRE_REFRESH_MINUTE=0
# Optional — override MITRE ATLAS YAML source (default: mitre-atlas/atlas-data ATLAS.yaml)
ATLAS_YAML_URL=https://raw.githubusercontent.com/mitre-atlas/atlas-data/main/data/ATLAS.yaml
# Optional — custom CVE→ATT&CK mappings JSON; if unset or fetch fails, uses CTID mappings-explorer CSV
MITRE_CVE_MAPPINGS_JSON_URL=
# Incremental ingest intervals (APScheduler, single-node)
NVD_SYNC_INTERVAL_HOURS=1
KEV_SYNC_INTERVAL_MINUTES=15
EPSS_SYNC_INTERVAL_HOURS=6
INCIDENT_FEED_REFRESH_MINUTES=30
# CISA Vulnrichment snapshot (cisagov/vulnrichment — gap-fills CVSS/CWE/CPE before NVD analysis)
VULNRICHMENT_SYNC_INTERVAL_HOURS=6
VULNRICHMENT_BRANCH=develop
# cvelistV5 incremental sync (CVEProject/cvelistV5 — GitHub compare deltas; watermark in sync_state)
CVELISTV5_SYNC_INTERVAL_MINUTES=30
CVELISTV5_BRANCH=main
CVELISTV5_INITIAL_SINCE_DAYS=7
NVD_SYNC_OVERLAP_MINUTES=15
# Resilient HTTP client — circuit breaker per outbound source
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=60
# Optional: API key from https://vulnerability.circl.lu (raises CIRCL rate limits)
CIRCL_API_KEY=
SCHEDULER_TIMEZONE=Asia/Kolkata
# BRIEFR nightly correlation engine — shared infra, actor, temporal analysis (default: 01:00 Asia/Kolkata)
CORRELATION_HOUR=1
CORRELATION_MINUTE=0
CORRELATION_TIMEZONE=Asia/Kolkata
MAX_CVES_PER_FETCH=2000
NVD_DAYS_BACK=14
# KEV job: fetch missing KEV CVEs from NVD by ID (not a full NVD refresh)
KEV_CROSS_FETCH_NVD=1
DEFAULT_TIMEZONE=Asia/Kolkata
# Optional — AI executive summary when exporting PDFs only (never on page load)
# Groq: free at https://console.groq.com/
GROQ_API_KEY=your_key_here
# Anthropic fallback: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here
# Optional — GitHub API token for detection rule search (SigmaHQ + Elastic repos)
# and PoC-in-GitHub index sync (raises GitHub API rate limits).
# Without token: 60 requests/hour. With token: 5000 requests/hour.
# Generate at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_token_here
# Exploit-availability scheduler feeds (PoC-in-GitHub, ExploitDB, Metasploit, Nuclei)
# Set EXPLOIT_SOURCES_SYNC_ENABLED=0 to disable the combined job.
EXPLOIT_SOURCES_SYNC_ENABLED=1
EXPLOIT_SOURCES_SYNC_INTERVAL_HOURS=24
EXPLOIT_SOURCES_THROTTLE_SECONDS=2
POC_GITHUB_SYNC_ENABLED=1
POC_GITHUB_THROTTLE_SECONDS=0.5
EXPLOITDB_SYNC_ENABLED=1
METASPLOIT_SYNC_ENABLED=1
NUCLEI_SYNC_ENABLED=1

# Playwright UI smoke (CI / local dev only — never set on production)
# PLAYWRIGHT_SMOKE=1 enables backend/tests/test_playwright_smoke.py
# PLAYWRIGHT_BACKEND_PORT=8765
# PLAYWRIGHT_FRONTEND_PORT=5173
# PLAYWRIGHT_BACKEND_URL=http://127.0.0.1:8765
