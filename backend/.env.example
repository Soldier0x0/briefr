# Copy to backend/.env and fill secrets. Keys are grouped for side-by-side diff with your .env.
# Install / link Postgres: docs/SELF_HOST.md §2 (dev) or §3 (production); deep reference: docs/POSTGRES.md
# Many scheduler/ML toggles are also editable in Admin → Config after first boot.

# --- Deploy ---
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173,https://projectjupiter.in
# Production posture by default (disables /api/docs, /api/redoc, /api/openapi.json;
# requires JWT_SECRET below). Set BRIEFR_ENV=development only for local dev.
BRIEFR_ENV=production
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_FORMAT=json

# --- Database (PostgreSQL required in production) ---
BRIEFR_REQUIRE_POSTGRES=1
# BRIEFR_RATE_LIMIT_STORE=db
# BRIEFR_SCHEDULER_ENABLED=0
DATABASE_POOL_ACQUIRE_TIMEOUT_SECONDS=10
DATABASE_POOL_COMMAND_TIMEOUT_SECONDS=60
DATABASE_POOL_SIZE=20
DATABASE_URL=postgresql://briefr:briefr@127.0.0.1:5432/briefr

# --- Auth (required in production: uncomment JWT_SECRET) ---
# JWT_SECRET=generate_a_long_random_secret_here
AUTH_COOKIE_SECURE=1
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Encrypt secret-typed rows in app_settings when Admin saves API keys (ADR-006).
# Optional — without it, secrets stay in .env / process env only (recommended until set).
# BRIEFR_SETTINGS_KEY=generate_a_long_random_secret_here

# --- Rate limits (set RATE_LIMIT_ENABLED=0 to disable) ---
RATE_LIMIT_ADMIN_READ_PER_MINUTE=120
RATE_LIMIT_AUTH_REFRESH_PER_MINUTE=30
RATE_LIMIT_ENABLED=1
RATE_LIMIT_IOC_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_WALLBOARD_PER_MINUTE=60
# WALLBOARD_TOKEN=generate_a_long_random_secret_here

# --- External API keys (alphabetical; empty = feature stays disabled) ---
ABUSECH_AUTH_KEY=your_abusech_auth_key_here
VULNCHECK_API_KEY=
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
CEREBRAS_API_KEY=your_key_here
CIRCL_API_KEY=
GEMINI_API_KEY=your_key_here
GITHUB_TOKEN=your_github_token_here
GREYNOISE_API_KEY=your_greynoise_api_key_here
GROQ_API_KEY=your_key_here
NVD_API_KEY=your_nvd_api_key_here
OPENROUTER_API_KEY=your_key_here
OTX_API_KEY=your_otx_api_key_here
VIRUSTOTAL_API_KEY=your_vt_api_key_here

# --- OTX tuning (skipped when OTX_API_KEY unset) ---
OTX_CONTINUOUS_BUDGET_PER_RUN=600
OTX_CONTINUOUS_INTERVAL_MINUTES=5
OTX_CONTINUOUS_SYNC_ENABLED=1
OTX_CORRELATION_HOUR=2
OTX_CORRELATION_MINUTE=0
OTX_CORRELATION_TIMEZONE=Asia/Kolkata
OTX_CVE_SYNC_DAYS=30
OTX_HOURLY_LIMIT=10000
OTX_IOC_SYNC_MAX_PER_RUN=500

# --- Scheduler: cron jobs ---
# CACHE_REFRESH_* — unused; no APScheduler job reads these (legacy env compatibility only).
CACHE_REFRESH_HOUR=6
CACHE_REFRESH_MINUTE=0
CORRELATION_HOUR=1
CORRELATION_MINUTE=0
CORRELATION_MITRE_MIN_OVERLAP=0.25
CORRELATION_TIMEZONE=Asia/Kolkata
MITRE_REFRESH_HOUR=2
MITRE_REFRESH_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- Scheduler: ingest intervals ---
CVELISTV5_BRANCH=main
CVELISTV5_INITIAL_SINCE_DAYS=7
CVELISTV5_SYNC_INTERVAL_MINUTES=30
EPSS_SYNC_INTERVAL_HOURS=6
INCIDENT_FEED_REFRESH_MINUTES=30
KEV_SYNC_INTERVAL_MINUTES=15
NVD_SYNC_INTERVAL_HOURS=1
VULNRICHMENT_BRANCH=develop
VULNRICHMENT_SYNC_INTERVAL_HOURS=6

# --- Ingest tuning ---
ATLAS_YAML_URL=https://raw.githubusercontent.com/mitre-atlas/atlas-data/main/data/ATLAS.yaml
CIRCUIT_COOLDOWN_SECONDS=60
CIRCUIT_FAILURE_THRESHOLD=3
EXPLOIT_SOURCES_SYNC_ENABLED=1
EXPLOIT_SOURCES_SYNC_INTERVAL_HOURS=24
EXPLOIT_SOURCES_THROTTLE_SECONDS=2
EXPLOITDB_SYNC_ENABLED=1
KEV_CROSS_FETCH_NVD=1
MAX_CVES_PER_FETCH=2000
METASPLOIT_SYNC_ENABLED=1
MITRE_CVE_MAPPINGS_JSON_URL=
NUCLEI_SYNC_ENABLED=1
NVD_DAYS_BACK=14
NVD_SYNC_OVERLAP_MINUTES=15
POC_GITHUB_SYNC_ENABLED=1
POC_GITHUB_THROTTLE_SECONDS=0.5
SCHEDULER_DB_CONCURRENCY=3
# Bounded graceful-shutdown drain for running jobs + background tasks (PR-R1)
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=10

# --- Backups ---
BACKUP_DIR=/var/lib/briefr/backups
BACKUP_ENABLED=1
BACKUP_LOG_BACKUP_COUNT=5
BACKUP_LOG_MAX_BYTES=5242880
BACKUP_RETENTION_COUNT=100
# BACKUP_AGE_KEY_FILE=/var/lib/briefr/keys/backup-age.key

# --- LLM router (PDF summaries + optional ML; needs at least one provider key) ---
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL_SUMMARY=openai/gpt-oss-120b
# SCHEDULER_LLM_TIMEOUT_SECONDS=30
# GROQ_RPM_LIMIT=30
# GROQ_TPM_LIMIT=8000
# GROQ_HEADROOM_PCT=85
# GROQ_ESTIMATED_TOKENS_PER_REQUEST=1000
# GROQ_MIN_REQUEST_INTERVAL_SECONDS=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_RPM_LIMIT=15
# GEMINI_TPM_LIMIT=250000
# GEMINI_HEADROOM_PCT=85
# GEMINI_ESTIMATED_TOKENS_PER_REQUEST=1500
# GEMINI_MIN_REQUEST_INTERVAL_SECONDS=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_RPM_LIMIT=30
# CEREBRAS_TPM_LIMIT=60000
# CEREBRAS_HEADROOM_PCT=85
# CEREBRAS_ESTIMATED_TOKENS_PER_REQUEST=1500
# CEREBRAS_MIN_REQUEST_INTERVAL_SECONDS=
# OPENROUTER_RPM_LIMIT=20
# OPENROUTER_TPM_LIMIT=40000
# OPENROUTER_DAILY_LIMIT=50
# OPENROUTER_HEADROOM_PCT=85
# OPENROUTER_ESTIMATED_TOKENS_PER_REQUEST=1500
# OPENROUTER_MIN_REQUEST_INTERVAL_SECONDS=
# OPENROUTER_MODEL_PRODUCT=google/gemma-4-31b-it:free
# OPENROUTER_MODEL_PDF=google/gemma-4-31b-it:free
# Store failed LLM request payload bodies in ai_operation_payloads (admin-only, 7d TTL).
# Default off to preserve ADR-AI-5 metadata-only behavior.
AI_OPERATIONS_STORE_FAILURE_PAYLOADS=0

# --- Durable jobs (Procrastinate; Postgres only; default off) ---
PROCRASTINATE_ENABLED=0
# Per-attempt outbound metering (api_call_events); default on when table exists
API_CALL_EVENTS_ENABLED=1

# --- CPE software catalog (Q3; scheduler; default off) ---
CPE_CATALOG_SYNC_ENABLED=0
CPE_CATALOG_SYNC_INTERVAL_HOURS=6
CPE_CATALOG_MAX_PAGES=10
# CPE_CATALOG_PAGE_SIZE=2000

# --- Stack Tier A backfill (Q4; default off) ---
STACK_BACKFILL_ENABLED=0
STACK_BACKFILL_MAX_PRODUCTS=10
STACK_BACKFILL_MAX_CVES=5000
# STACK_BACKFILL_MAX_RUNTIME_SECONDS=3600

# --- ML (scheduler-side; requires pip install fastembed when EMBEDDINGS_ENABLED=1) ---
DETECTION_CONTEXT_LLM_ENABLED=0
DETECTION_CONTEXT_LLM_INTERVAL_HOURS=12
DETECTION_CONTEXT_LLM_MAX_PER_RUN=10
# Nuclei YAML parser enriches detection_ctx on exploit_sync (D4; default on)
# DETECTION_CONTEXT_NUCLEI_ENABLED=1
# DETECTION_CONTEXT_NUCLEI_MAX_PER_RUN=50
# DETECTION_CONTEXT_SYNC_ENABLED=0
# DETECTION_CONTEXT_SYNC_INTERVAL_HOURS=6
# DETECTION_CONTEXT_SYNC_MAX_PER_RUN=500
EMBEDDINGS_CACHE_DIR=
EMBEDDINGS_ENABLED=0
EMBEDDINGS_AUTO_ON_INGEST=1
EMBEDDINGS_INGEST_MAX_PER_RUN=25
EMBEDDINGS_MAX_PER_RUN=2000
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_SYNC_INTERVAL_HOURS=6
# Dual-write to embeddings (pgvector / SQLite BLOB). Set 0 for legacy cve_embeddings only.
EMBEDDINGS_PGVECTOR=1
LLM_PRODUCT_EXTRACTION_ENABLED=0
LLM_PRODUCT_EXTRACTION_INTERVAL_HOURS=6
LLM_PRODUCT_EXTRACTION_MAX_PER_RUN=10
# OPENROUTER_MODEL_DETECTION=google/gemma-4-31b-it:free

# --- Webhooks (uncomment destination + set *_ENABLED=1) ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# DISCORD_WEBHOOK_ENABLED=1
# DISCORD_WEBHOOK_EVENTS=kev_alert,backup_failure,health
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_WEBHOOK_ENABLED=1
# TELEGRAM_WEBHOOK_EVENTS=kev_alert,backup_failure,health
# WEBHOOK_GENERIC_URL=https://hooks.example.com/briefr
# WEBHOOK_GENERIC_ENABLED=1
# WEBHOOK_GENERIC_EVENTS=kev_alert,backup_failure,health
# WEBHOOK_GENERIC_LABEL=PagerDuty
# BRIEFR_STACK_TERMS=nginx,log4j,windows
# BACKUP_INTERVAL_HOURS=6

# --- Dev / CI only (never on production) ---
# PLAYWRIGHT_SMOKE=1
# PLAYWRIGHT_BACKEND_PORT=8765
# PLAYWRIGHT_FRONTEND_PORT=5173
# PLAYWRIGHT_BACKEND_URL=http://127.0.0.1:8765
