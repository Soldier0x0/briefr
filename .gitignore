# Cross-cutting ignores. backend/.gitignore and frontend/.gitignore cover
# their own subtrees in more detail.
node_modules/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.local
*.db
*.db-wal
*.db-shm
.DS_Store
Thumbs.db
.idea/
.vscode/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Generated artifacts — build on demand via scripts/
SYSTEM_DESIGN.pdf
TECHNICAL_INVENTORY.xlsx
architecture-map.html

# Automation loop working files (execution-playbook queue runner) — never commit
.loop-queue.txt
.loop-state.txt
.claude/loop-queue.txt
.claude/loop-state.txt

# Graphify — graph.json/graph.html/GRAPH_REPORT.md committed; ignore cache/internals
graphify-out/cache/
graphify-out/20*/
graphify-out/.graphify_*
graphify-out/manifest.json
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
