{
  "name": "briefr-frontend",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "audit:ci": "npm audit --audit-level=high",
    "test:unit": "node --test 'src/**/*.test.js'",
    "lint": "eslint src/scoring src/pages/admin",
    "format": "prettier --write \"src/scoring/**/*.{js,jsx,css}\" \"src/pages/admin/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/scoring/**/*.{js,jsx,css}\" \"src/pages/admin/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@tanstack/react-table": "^8.21.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.0",
    "prettier": "^3.9.5",
    "vite": "^8.1.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "dompurify": "^3.4.12",
    "minimatch": "^10.2.5",
    "react-router": "8.3.0",
    "uuid": "^11.1.1"
  }
}
