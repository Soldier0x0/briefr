flowchart TB
  subgraph External["External services"]
    NVD[NVD API 2.0]
    KEV[CISA KEV JSON]
    EPSS[FIRST EPSS CSV/API]
    MITRE[MITRE ATT&CK STIX]
    ATLAS[MITRE ATLAS YAML]
    SPL[Sploitus]
    GN[GreyNoise]
    VT[VirusTotal]
    AIPDB[AbuseIPDB]
    OTX[AlienVault OTX]
    OSV[OSV.dev]
    CIRCL[CIRCL CVE-Search]
    MB[MalwareBazaar]
    UH[URLhaus]
    GROQ[Groq API]
    ANTH[Anthropic API]
    GH[GitHub API]
    RSS[RSS feeds ×6]
    CVLIST[cvelistV5 GitHub]
    VULN[CISA Vulnrichment]
  end

  subgraph Scheduler["APScheduler — scheduler.py (14 base jobs + 3 conditional)"]
    J1[nvd_incremental_sync]
    J2[kev_metadata_sync]
    J3[epss_score_sync]
    J4[weekly_mitre_refresh]
    J5[atlas_version_check]
    J6[otx_nightly_correlation]
    J7[otx_continuous_sync · if enabled]
    J8[incident_feed_refresh · if not smoke test]
    J9[exploit_sources_sync · if enabled]
    J10[embeddings_backfill]
    J11[llm_product_extraction]
    J12[nightly_correlation]
    J13[vulnrichment_snapshot_sync]
    J14[cvelistv5_incremental_sync]
    J15[scheduled_backup]
    J16[backup_deadman_check]
    J17[session_cleanup]
  end

  subgraph Backend["FastAPI — main.py + routers/"]
    API["REST /api/*<br/>request_id middleware · rate limits"]
    AUTH_G["require_admin — /api/admin/* · /api/refresh*"]
    SESS["auth — sessions + JWT cookies"]
    POSTURE["production_posture_warnings (A6)"]
  end

  subgraph Database["PostgreSQL 16 — production required"]
    direction TB
    T_intel["Intel: cves · kev_deadlines · epss_history<br/>mitre_* · atlas_* · otx_* · correlation_*<br/>cve_exploits · cve_embeddings · hunt_packs"]
    T_app["App: users · sessions · watchlist<br/>feed_cache · ioc_cache · sync_state<br/>audit_log · api_usage · webhook_*"]
  end

  subgraph Frontend["React 19 — frontend/src"]
    GATE["RequireAuth → /login"]
    BRIEF["BRIEF — MorningBrief · BriefCharts · heatmap"]
    FEED["FEED — CVEFeed · CVECard · Sidebar"]
    DRAWER["DetailDrawer + openCveDrawer.js"]
    IOC_UI[IOCLookup]
    CASE["Incidents — CaseStudies"]
    FORGE[Forge tab]
    ADMIN_UI["AdminPage — Security · jobs · logs"]
    ERR["Toast + inline errors — detail + ref + retry (A3/A5)"]
    PDF[pdfReport.js]
  end

  J1 --> NVD --> T_intel
  J2 --> KEV --> T_intel
  J3 --> EPSS --> T_intel
  J4 --> MITRE --> T_intel
  J4 --> ATLAS --> T_intel
  J6 --> OTX --> T_intel
  J7 --> OTX
  J8 --> RSS --> T_app
  J9 --> GH --> T_intel
  J10 --> T_intel
  J11 --> GROQ
  J12 --> T_intel
  J13 --> VULN --> T_intel
  J14 --> CVLIST --> T_intel
  J15 --> T_app
  J16 --> T_app
  J17 --> T_app

  GATE --> BRIEF & FEED & DRAWER & IOC_UI & CASE & FORGE
  BRIEF -->|GET /api/brief · /stats · /changes| API
  FEED -->|GET /api/cves · /watchlist| API
  DRAWER -->|GET /api/cves/id + sub-routes| API
  IOC_UI -->|POST /api/ioc/lookup| API
  CASE -->|GET /api/case-studies/feed| API
  FORGE -->|GET /api/forge/coverage · /hunt-packs/*| API
  ADMIN_UI --> AUTH_G
  PDF -->|POST /api/ai/summary| API

  API --> T_intel & T_app
  API --> SPL & GN & VT & AIPDB & OTX & OSV & CIRCL & MB & UH & GROQ & ANTH & GH
  SESS --> T_app
  AUTH_G --> SESS
  POSTURE --> ADMIN_UI
  API -.->|X-Request-ID on errors| ERR

  Note1["SQLite + db/dialect.py translation: tests/dev only.<br/>Production: BRIEFR_REQUIRE_POSTGRES=1."]
